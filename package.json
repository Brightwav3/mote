{
  "name": "mote-avatar",
  "version": "0.2.0",
  "description": "An expressive avatar for an AI agent: mount it, then call one method per state of the turn.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/mote-avatar.js",
  "module": "./dist/mote-avatar.js",
  "types": "./dist/mote-avatar.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mote-avatar.d.ts",
      "import": "./dist/mote-avatar.js",
      "default": "./dist/mote-avatar.js"
    },
    "./demo": "./dist/index.html",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "build.mjs",
    "NOTICE",
    "LICENSE",
    "LICENSE-BLOUB",
    "LICENSE-BLOBATAR",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "avatar",
    "agent",
    "ai",
    "llm",
    "svg",
    "animation",
    "assistant"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brightwav3/mote.git"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/affect.test.mjs test/agent.test.mjs test/anim.test.mjs test/episodes.test.mjs test/expressions.test.mjs test/fitting.test.mjs test/mount.test.mjs test/shapes.test.mjs test/structure.test.mjs",
    "check": "npm run build && npm test",
    "serve": "node serve.mjs",
    "prepare": "node build.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
